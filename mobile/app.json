{
  "expo": {
    "name": "Trinity",
    "slug": "trinity-life-optimizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trinity",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.trinity.lifeoptimizer"
    },
    "android": {
      "package": "com.trinity.lifeoptimizer",
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trinity uses your location to show local UV and air quality."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B01B10"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Trinity uses motion sensors to count steps while the app is open."
        }
      ],
      "./plugins/with-ble-permissions",
      "./plugins/with-cmake-long-paths"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
