{
  "expo": {
    "name": "Auxo",
    "slug": "trinity-life-optimizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trinity",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.auxo.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Auxo uses your location to map your walk and show local air quality.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Auxo records your route while you walk, including when the screen is off.",
        "NSMotionUsageDescription": "Auxo uses the motion sensor to count your steps accurately."
      }
    },
    "android": {
      "package": "com.auxo.app",
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE",
        "READ_CALL_LOG"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#070708",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "minSdkVersion": 26,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070708",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 1
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Auxo uses your location to map your walk and show local air quality.",
          "locationAlwaysAndWhenInUsePermission": "Auxo records your route while you walk, including when the screen is off.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C6F24E"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Auxo uses motion sensors to count steps while the app is open."
        }
      ],
      "./plugins/with-ble-permissions",
      "./plugins/with-cmake-long-paths",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Auxo uses the camera to scan food barcodes."
        }
      ],
      "expo-build-properties",
      "react-native-health-connect",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/baloo-2/400Regular/Baloo2_400Regular.ttf",
            "./node_modules/@expo-google-fonts/baloo-2/500Medium/Baloo2_500Medium.ttf",
            "./node_modules/@expo-google-fonts/baloo-2/600SemiBold/Baloo2_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/baloo-2/700Bold/Baloo2_700Bold.ttf",
            "./node_modules/@expo-google-fonts/baloo-2/800ExtraBold/Baloo2_800ExtraBold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
