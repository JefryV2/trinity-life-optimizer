# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the client bundle.
EXPO_PUBLIC_NHOST_SUBDOMAIN=
EXPO_PUBLIC_NHOST_REGION=
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# Set to 1 only after Apple sign-in is enabled in Nhost and you have an Apple Developer account.
EXPO_PUBLIC_APPLE_SIGNIN=

# Optional: POST anonymous activation counters here. Leave blank for local-only.
EXPO_PUBLIC_ANALYTICS_ENDPOINT=

# The Auxo Nhost function that estimates meal components from a photo.
# POST { imageBase64, mimeType } with the user's Nhost access token.
# The function owns the Gemini key; no provider key belongs in the app.
# Example: https://<subdomain>.functions.<region>.nhost.run/v1/meal-vision
EXPO_PUBLIC_MEAL_VISION_ENDPOINT=
